# ARTA Platform — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to source control.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Default: ollama (runs locally, no API key needed)
# Options: ollama | anthropic | google_gemini | openai
ARTA_LLM_PROVIDER=ollama
ARTA_LLM_MODEL=qwen2.5:32b
OLLAMA_BASE_URL=http://localhost:11434

# ── Anthropic AI (only required when ARTA_LLM_PROVIDER=anthropic) ─────────────
# ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# The DATABASE_URL is the primary secret (contains password).
# POSTGRES_* vars still needed for the postgres service to initialise at bootstrap.
# Keep DATABASE_URL and POSTGRES_PASSWORD in sync when you rotate.
POSTGRES_USER=arta
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=arta
DATABASE_URL=postgresql+asyncpg://arta:change-me-strong-password@postgres:5432/arta

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Leave blank REDIS_PASSWORD for no-auth (local dev only). Set a strong password
# for staging/prod and update REDIS_URL to match (redis://:PASSWORD@redis:6379).
REDIS_PASSWORD= 
REDIS_URL=redis://:@redis:6379

# ── ARTA API ─────────────────────────────────────────────────────────────────
# API key required for admin endpoints (PUT /api/gates/thresholds, POST /defects/file-jira)
ARTA_API_KEY=change-me-admin-api-key

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3001

# Deployment environment: development | staging | production
ENVIRONMENT=development

# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ARTA_API_URL: only needed when running the frontend OUTSIDE docker
# compose. Inside compose, leave unset — Next.js rewrites in next.config.js
# proxy /api/* to ARTA_API_INTERNAL_URL (default http://arta-api:8000) over the
# docker network, so the browser only needs to talk to the frontend.
# F20-10: ARTA's host port mapping moved 8000 → 38087 to avoid clashes with
# other dev services on the host (the container's INTERNAL port is still 8000).
NEXT_PUBLIC_ARTA_API_URL=http://localhost:38087

# F20-10: Override the published host port if 38087 ever clashes on your machine.
# Container-internal port stays 8000; only the host-side mapping changes.
ARTA_API_HOST_PORT=38087

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# First-run admin bootstrap: when the users table is EMPTY at startup and both
# vars are set, ARTA creates this admin account. Unset after first login.
# ARTA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# ARTA_BOOTSTRAP_ADMIN_PASSWORD=change-me

# No-database demo login (admin@arta.dev / demo1234). NEVER in production.
# ARTA_DEMO_MODE=1

# Anonymous usage telemetry (bucketed counts + enums only — full field list in
# docs/TELEMETRY.md). Set to 0 for zero network calls (air-gap safe).
# ARTA_TELEMETRY=1
# ARTA_TELEMETRY_EXTENDED=1   # opt-in Tier-2 events

# ── Optional Integrations ─────────────────────────────────────────────────────
# Jira (for auto-filing defects)
# JIRA_HOST=https://your-org.atlassian.net
# JIRA_USER=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=PROJ

# GitHub (for self-healing PRs)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=org/repo

# Slack (for gate decision notifications)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── F20-27: env-vars main.py reads with defaults (documented for completeness) ─
# Most users never touch these; they're listed so a `grep .env` shows everything.
# CLAUDE_CLI_PATH=/opt/claude-node/bin/claude   # claude_code provider only
# ARTA_FAST_MODEL=qwen3:8b                      # Risk/ATDD (cheap)
# ARTA_PRIMARY_MODEL=arta-qwen-pro:latest       # Automation scripts (default)
# ARTA_DEEP_MODEL=qwen3:32b                     # Deep analysis fallback
# ARTA_LOG_LEVEL=INFO                           # DEBUG/INFO/WARNING/ERROR
# CHROMA_URL=http://chromadb:8001
# NEO4J_URI=bolt://neo4j:7687
# ARTA_PROJECTS_FILE=.arta/projects.json

# ── F20-26: OWASP ZAP (security scans) ────────────────────────────────────────
# ZAP runs as a service in compose (see docker-compose.yml `zap` block).
# ZAP_HOST_PORT picks the host-side mapping; container-internal port stays 8080.
ZAP_API_URL=http://zap:8080
ZAP_HOST_PORT=38090
# ZAP_API_KEY=                                   # Set if you remove `api.disablekey=true` for prod
# A11Y_REPORT_PATH=/var/arta/artifacts/a11y-report.json

# ── F20-27: SECRETS — always rotate before any non-local-dev use ──────────────
# Generate strong values with: ./scripts/gen-secret.sh (writes hex to stdout).
# Or one-liner: openssl rand -hex 32
#
# Secrets above with `change-me-*` placeholders MUST be rotated before:
#   - any deployment beyond your local dev box
#   - sharing the .env file with anyone
#   - committing related infra (docker-compose.prod.yml etc.)
# main.py logs a WARNING at startup if any 'change-me-*' value is detected.

# ── R153 Tier 1 — ARTA Discovery Probe Killswitches (R150-R152) ───────────────
# Emergency operator shutoffs for chromium probe crashes + HAR capture issues.
# All default-off (leave commented). Reference: CLAUDE.md
# "R150.L + R152.A: Crash-prone SPA route skip-list".

# R150.L + R152.A — comma-separated SPA route paths/prefixes (leading slash).
# Prefix-match by default (`/admin` skips /admin AND /admin/{X}/{Y}). Append
# `=` for exact-match only (`/accounts=` skips ONLY /accounts).
# A generic default ships via docker-compose.yml; override per deployment:
# here OR via shell env to extend for other SUTs.
# ARTA_R150_SKIP_ROUTES=/accounts,/users,/settings

# R152.B — maximum-safety mode. When set to "1", probe walks ONLY `/` +
# HARDCODED_ROUTES (no captured / R150.I-derived / org-derived routes).
# Use when R150.L+R152.A prefix-skip can't keep up with arbitrary SPA-crash
# routes. Trade-off: less DOM catalog depth in exchange for clean probe
# completion + HAR finalization.
# ARTA_R150_M_HARDCODED_ONLY=1

# R150.A — revert HAR capture from `mode:'full'` to `mode:'minimal'`.
# `full` mode embeds response bodies (needed for response_body_shape ingest).
# Set to 1 only if `full` mode causes disk-pressure or capture issues.
# ARTA_R150_A_BODY_CAPTURE_DISABLE=1

# R145.A.3 — disable startup auto-purge of REPLACE_ME artifacts. The sweeper
# walks .arta/ artifacts at boot + removes templated-not-filled placeholders.
# Disable if you want to preserve artifacts for manual inspection.
# ARTA_R145_A_AUTO_PURGE_DISABLE=1

# R146.C.2 — disable chromium TLS-insecure layer. When R146.C classifier
# detects cert-asymmetry, R146.C.2 injects `--ignore-certificate-errors`.
# Set to 1 to force-skip this layer (e.g., for strict-TLS environments).
# ARTA_R146_C2_TLS_INSECURE_DISABLE=1

# ── R153 Tier 2 — ARTA LLM Retry & Cost Knobs (R141) ──────────────────────────
# Claude CLI rate-limit retry tuning. Defaults below tuned for tier-1 Anthropic
# accounts; adjust upward for higher tiers OR downward for cost-bounded runs.

# R141.D — max retry attempts per LLM call when rate-limited (429). Each
# retry adds an exponentially-growing backoff (R141.D_BASE_DELAY_S × 2^N).
# Default 3 covers most transient throttles.
# ARTA_R141_D_MAX_ATTEMPTS=3

# R141.D — first backoff delay in seconds. Allowed range: 0.1-60.0.
# ARTA_R141_D_BASE_DELAY_S=4.0

# R141.D — hard cap on any single backoff wait (honors Anthropic's
# Retry-After header if smaller). Allowed range: 1.0-300.0.
# ARTA_R141_D_MAX_DELAY_S=30.0

# R141.A — max LLM turns per cluster RCA. Default 2 bumped from original 1
# in R141.A. Raise to 3+ for harder clusters at cost of wallclock + tokens.
# ARTA_CLAUDE_CLI_MAX_TURNS=2

# ── R153 Tier 3 — ARTA Discovery Probe Tuning (R140, R150, R151) ──────────────
# Tradeoff knobs for discovery probe behavior. Raise BFS_DEPTH for richer DOM
# catalog; lower or use R152.B max-safety mode for crash-prone SUTs.

# R140.C — SPA tree depth for BFS link-extract. 0 = visit seed routes only;
# 1 = walk one level of a[href] links; 2-3 = deeper (slower + more crash
# exposure). Allowed range: 0-3.
# ARTA_R140_BFS_DEPTH=1

# R150.H — revert strict SPA hydration wait. R150.H polls (up to 6s) for
# `document.readyState === complete` + no [aria-busy] + no [data-loading]
# before DOM snapshot. Disable if it causes false-positive timeouts.
# ARTA_R150_H_HYDRATION_STRICT_DISABLE=1

# R151.B — revert to hardcoded API_PROBES only. R151.B dynamically merges
# analytics-class endpoints from `.arta/discovered_endpoints/<pid>.json`.
# Disable if dynamic merge causes excessive XHR fan-out OR rate-limiting.
# ARTA_R151_B_DYNAMIC_PROBES_DISABLE=1

# ── R153 Tier 4 — ARTA Operational Caps ───────────────────────────────────────
# Cross-cutting caps for long-running smokes + Ollama daemon coordination.

# R144.E — orphan-sweep TTL in minutes. Run-completion checks fail after
# this much wallclock without progress (heartbeats). Bumped from 75 → 180
# in R144.E for long Iter-N smoke windows.
# ARTA_ORPHAN_SWEEP_TTL_MIN=180

# R130.G — parallel test-gen requests against the LLM provider. Ollama
# qwen-pro is single-instance per model (2 concurrent typical). Anthropic
# native handles higher concurrency (4+). Leave unset for provider-aware
# default.
# ARTA_GEN_CONCURRENCY=2

# R143.D — full revert of chromium DNS bridge. R143.D injects
# `--host-resolver-rules` into chromium when arta-api can reach the SUT
# but chromium can't (e.g., docker network bridge gap). Set to 1 to skip
# the bridge entirely (reverts to R113.J log-only behavior).
# ARTA_R143_D_DISABLE=1

# ── R154 — ARTA non-mutation guarantee (probe + gen + dispatch) ────────────────
# ATDD mission: ARTA reports SUT quality WITHOUT mutating SUT state.
# Three-stage structural defense (probe + gen + dispatch). All
# default-on / default-deny; opt-out paths require explicit operator
# action + emit loud WARN logs.
# Reference: CLAUDE.md "R154 — non-mutation guarantee" + plan-file R154.

# R154.A — disable probe UI-interaction triggering. Default off (probe
# DOES drive read-side clicks on catalog button/link entries to fire
# authenticated XHRs against the SUT, populating response_body_shape).
# The 3-layer structural defense (Layer 1 chromium-level method
# allowlist, Layer 2 read-side label allowlist, Layer 3 element-type
# guard) stays active even when this is OFF; this only disables the
# click loop itself.
# ARTA_R154_A_UI_INTERACTIONS_DISABLE=1

# R154.A — per-route click cap (default 5). PERFORMANCE bound, NOT
# safety bound. Safety is enforced structurally by Layer 1+2+3. Raise
# for DOM-rich SUTs; lower for wallclock-bounded probes. Range: 0-20.
# ARTA_R154_A_MAX_CLICKS_PER_ROUTE=5

# R154.A Layer 1 — DISABLE the chromium-level HTTP-method allowlist.
# DANGEROUS: with this set, the probe can fire POST/PUT/PATCH/DELETE
# against the SUT, mutating SUT state during discovery. Use ONLY with
# explicit operator approval + a SUT test-sandbox environment. Emits
# a loud WARN log when set. Default-off (probe is non-mutating).
# ARTA_R154_A_LAYER1_DISABLE=1

# R154.B — disable gen-time destructive-pattern validator. Default off
# (validator rejects LLM specs containing request.post/put/patch/delete,
# page.fill, checkbox/radio toggles, type=submit buttons, and Pytest
# destructive helpers). Opt-out only when operator has explicit
# bug-bash workflow + accepts ARTA may generate destructive specs.
# ARTA_R154_B_DESTRUCTIVE_VALIDATOR_DISABLE=1

# R154.C — disable dispatch-time non-mutation gate. Default off (gate
# BLOCKs destructive specs without operator opt-in). Reverts to pre-R154
# dispatch behavior when set.
# ARTA_R154_C_DISPATCH_GATE_DISABLE=1

# R154.C — gate for INTENTIONAL destructive test specs. Default OFF;
# destructive specs are BLOCKED at dispatch by default. Operator
# opt-in for explicit bug-bash + verification workflows. MUST be paired
# with SUT_TEST_DATA_NAMESPACE AND the spec must carry the
# `// @intentional-destructive: <reason>` comment marker in its first
# 5 lines. All three conditions are required.
# ARTA_R154_ALLOW_DESTRUCTIVE_TESTS=1

# R154.C — SUT test-fixture sandbox namespace. REQUIRED when
# ARTA_R154_ALLOW_DESTRUCTIVE_TESTS=1. Destructive operations are
# scoped to this namespace so production data is NEVER mutated.
# SUT_TEST_DATA_NAMESPACE=arta-bugbash-2026


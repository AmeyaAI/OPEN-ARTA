# F4-2: Multi-stage Next.js build for the ARTA frontend.
#
# Stages:
#   deps    — install node_modules from package-lock.json (cacheable layer)
#   dev     — used by docker-compose.yml; runs `npm run dev` against bind-mounted source
#   build   — produces the standalone .next/standalone bundle
#   runtime — slim image with just node + the standalone bundle (no npm)
#
# Build (default = runtime):  docker build -t arta-frontend ./frontend
# Build dev target:           docker build --target dev -t arta-frontend:dev ./frontend
# Run:                        docker run -p 3000:3000 arta-frontend

# ── Stage 1: dependencies ─────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
# Copy only the manifest first so this layer caches when source changes.
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

# ── Stage 2: dev (used by docker-compose.yml dev profile) ─────────────────────
FROM node:20-alpine AS dev
WORKDIR /app
ENV NODE_ENV=development
COPY --from=deps /app/node_modules ./node_modules
COPY . .
EXPOSE 3000
# docker-compose mounts ./frontend over /app for HMR; this CMD is the fallback.
CMD ["npm", "run", "dev"]

# ── Stage 3: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# F8-19: explicit type-check before bundling. `next build` only checks the
# subset of files reachable from app/page entry points; running `tsc --noEmit`
# against the full tsconfig surface catches errors in untouched-but-imported
# modules. Now that F8-14 removed the `ignoreBuildErrors` escape hatch,
# letting tsc fail the image build provides the same safety from CI.
RUN npx tsc --noEmit
RUN npm run build

# ── Stage 4: runtime ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Create non-root user (matches the rest of the platform)
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy only the standalone bundle + static assets (≈ 50 MB total vs 500 MB for full node_modules)
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
# public/ is optional in this project — only copy if it exists in the build stage
# (avoids "not found" when there are no static public assets to ship)

USER nextjs
EXPOSE 3000

# server.js is generated by `next build` when output: 'standalone' is set in next.config.js
CMD ["node", "server.js"]

# Test runner output (pytest / Newman / k6 / Playwright JSON reports). These
# can be large per-run and are reproduced on every CI invocation.
junit.xml
junit-*.xml
test-output/

# ── ARTA execution data (HUGE — runtime state, not source) ────────────────────
# data/artifacts/ alone runs to ~80 GB after a few full-suite runs (Newman
# JSON reporters before R27, evidence zips, per-step HAR). models/ holds
# multi-GB GGUF + safetensor weights. outputs/ is QLoRA training output.
#
# IMPORTANT — these patterns are LEADING-SLASH ANCHORED so they only match
# the top-level directories at repo root. WITHOUT the leading slash, the
# `models/` pattern would also match `src/models/` (which holds Python
# Pydantic source code that MUST stay tracked). Same for fixtures vs
# src/fixtures.
/data/
/models/
/outputs/
/unsloth_compiled_cache/
# Per-test fixture parquet/csv files generated by `materialise_fixture` — these
# land in /fixtures/analytics (FIXTURES_DIR = REPO_ROOT/fixtures/analytics).
/fixtures/
# NOTE: `/src/fixtures/` was ALSO ignored here — a bug: that dir holds the
# generator SOURCE (generator.py, __init__.py), NOT generated data, so the
# generator module was never tracked (a fresh clone would ImportError). The
# rule is removed; generated data stays covered by `/fixtures/` above.

# Local DB volumes mounted into docker-compose
/pgdata/
/neo4j_data/
/chroma_data/
/redis_data/

# ── Build / Logs / Caches ──────────────────────────────────────────────────────
*.log
logs/
tmp/
.cache/

# Core dumps from chromium probe crashes (R150.L SPA-crash routes). A single
# dump runs to GBs (core.1158 was 2.6 GB and got committed). `core.[0-9]*` is
# the kernel's core.<pid> shape; the bare-`core` pattern is anchored to the
# playwright dir (where chromium runs) so a future `core/` source package
# elsewhere can't be silently ignored.
core.[0-9]*
/src/automation/playwright/core
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Upskill training datasets (regenerated by scripts/upskill_pipeline.py)
data/upskill/*.jsonl
data/upskill/_archive/
data/upskill/_filtered_dataset.jsonl

# Local SQLite (some operators run with a sqlite fallback)
*.sqlite3
*.sqlite3-journal

# Editor-local backups
*.orig
*.rej

# ── Previously-tracked files that NOW match these patterns ─────────────────────
# Ignore patterns do NOT un-track files already in the index. The operator
# must run cleanup ONCE to drop the legacy entries (files stay on disk;
# only tracking stops):
#
#   # Drop ALL of .arta/ from the index, then re-add — only the re-included
#   # templates above (arta.config.yaml, projects.example.json, scenarios/,
#   # environments/staging.json, environments/bugtrackr-local.json) come back.
#   git rm -r --cached .arta/
#   git add .arta/
#
#   # Build artifacts
#   git rm --cached frontend/tsconfig.tsbuildinfo
#
#   # Auto-generated unsloth modules (regenerated on first import)
#   git rm --cached -r unsloth_compiled_cache/
#
#   # 2.6 GB chromium core dump committed by accident (R150.L probe crash).
#   # Un-track AND delete from disk; it bloats every clone until history is
#   # rewritten (git filter-repo --path src/automation/playwright/core.1158
#   # --invert-paths).
#   git rm --cached src/automation/playwright/core.1158
#   rm src/automation/playwright/core.1158
#
# Then commit the cleanup.
#
# SECURITY NOTE: secrets that were tracked before this cleanup
# .arta/_e2e_jwt.txt) remain in git HISTORY after un-tracking. They expire
# history (git filter-repo) or rotate the credentials.
